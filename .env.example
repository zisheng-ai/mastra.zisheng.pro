# PostHog Analytics
# Get these from your PostHog project settings
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics
# Get this from Google Analytics (GA4 property)
GA_ID=G-XSL4QXVXDB

# Deployment
# Set DEPLOY_ENV=production only for the production deployment so previews
# and local development do not report analytics events.
DEPLOY_ENV=production
SITE_URL=https://mastra.zisheng.pro

# HubSpot
# Get these from your HubSpot account settings
HS_PORTAL_ID=12345678

# Algolia Search (if using search)
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_SEARCH_API_KEY=your_algolia_search_api_key

# HubSpot Forms (if using forms)
HS_FORM_GUID=your_form_guid

# Mastra Website URL
MASTRA_WEBSITE=https://mastra.ai

KAPA_INTEGRATION_ID=
