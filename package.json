{
  "name": "mastra-docs",
  "version": "0.0.65",
  "private": true,
  "repository": "https://github.com/mastra-ai/mastra",
  "homepage": "https://mastra.ai",
  "bugs": "https://github.com/mastra-ai/mastra",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "engines": {
    "node": "22.x",
    "pnpm": ">=11"
  },
  "scripts": {
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "docusaurus": "docusaurus",
    "dev": "pnpm build && pnpm serve --port 3000 --host localhost --no-open",
    "dev:fast": "pnpm dev:zh-CN",
    "dev:en": "docusaurus start --locale en",
    "dev:fr": "docusaurus start --locale fr",
    "dev:zh-TW": "docusaurus start --locale zh-TW",
    "dev:zh-HK": "docusaurus start --locale zh-HK",
    "dev:ja": "docusaurus start --locale ja",
    "dev:ko": "docusaurus start --locale ko",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 npm-run-all build:zh-CN build:en build:fr build:zh-TW build:zh-HK build:ja build:ko",
    "build:zh-CN": "docusaurus build --locale zh-CN --out-dir build",
    "build:en": "docusaurus build --locale en --out-dir build",
    "build:fr": "docusaurus build --locale fr --out-dir build",
    "build:zh-TW": "docusaurus build --locale zh-TW --out-dir build",
    "build:zh-HK": "docusaurus build --locale zh-HK --out-dir build",
    "build:ja": "docusaurus build --locale ja --out-dir build",
    "build:ko": "docusaurus build --locale ko --out-dir build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "node scripts/serve-build.mjs",
    "write-translations": "docusaurus write-translations",
    "i18n:zh-models": "node scripts/generate-zh-model-docs.mjs",
    "i18n:zh-TW-models": "node scripts/generate-zh-tw-model-docs.mjs && node scripts/restore-zh-tw-code-fences.mjs models",
    "i18n:zh-HK-models": "node scripts/generate-zh-hk-model-docs.mjs",
    "i18n:ko": "node scripts/generate-ko-localization.mjs",
    "i18n:zh-sidebars": "node scripts/localize-zh-sidebar-labels.mjs",
    "i18n:anchors": "node scripts/sync-localized-heading-anchors.mjs",
    "i18n:anchors:check": "node scripts/sync-localized-heading-anchors.mjs --check",
    "validate:frontmatter": "tsx scripts/validate-frontmatter.ts",
    "validate:reference-sidebar": "tsx scripts/validate-reference-sidebar-sort.ts",
    "validate:reference-sidebar:fix": "tsx scripts/validate-reference-sidebar-sort.ts --fix",
    "validate:sidebar-docs": "tsx scripts/validate-sidebar-docs.ts",
    "validate:sidebar-new-tags": "tsx scripts/validate-sidebar-new-tags.ts",
    "validate": "npm-run-all --parallel validate:frontmatter validate:reference-sidebar validate:sidebar-docs validate:sidebar-new-tags",
    "generate-vercel-redirects": "node scripts/generate-vercel-redirects.mjs",
    "format": "pnpm format:oxfmt && pnpm format:mdx",
    "vale:download": "node scripts/vale/download.mjs",
    "vale": "scripts/vale/bin/vale",
    "vale:sync": "scripts/vale/bin/vale sync",
    "lint:vale": "scripts/vale/bin/vale src/content/en/docs src/content/en/guides src/content/en/reference",
    "lint:vale:ai": "pnpm lint:vale --minAlertLevel=error --output=line",
    "lint:remark": "remark --no-stdout --frail --quiet --ext mdx src/content/en/docs src/content/en/guides src/content/en/reference",
    "lint:prose": "npm-run-all --parallel lint:vale:ai lint:remark",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "pnpm exec playwright test",
    "test:smoke": "pnpm exec playwright test tests/smoke.spec.ts --project=desktop",
    "test:og": "pnpm exec playwright test tests/og-image.spec.ts --project=desktop",
    "test:navigation": "pnpm exec playwright test tests/navigation.spec.ts",
    "format:check": "pnpm format:oxfmt:check && pnpm format:mdx:check",
    "format:oxfmt": "oxfmt .",
    "format:oxfmt:check": "oxfmt --check .",
    "format:mdx": "oxfmt-mdx --write src/content/en/docs src/content/en/guides src/content/en/reference",
    "format:mdx:check": "oxfmt-mdx --check src/content/en/docs src/content/en/guides src/content/en/reference"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/faster": "^3.10.1",
    "@docusaurus/plugin-content-docs": "^3.10.1",
    "@docusaurus/plugin-vercel-analytics": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/remark-plugin-npm2yarn": "^3.10.1",
    "@docusaurus/theme-common": "^3.10.1",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@kapaai/react-sdk": "^0.9.10",
    "@mastra/docusaurus-plugin-algolia": "^1.1.2",
    "@mastra/docusaurus-plugin-kapa": "^1.2.1",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.13.22",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.4",
    "hast-util-select": "^6.0.4",
    "hast-util-to-mdast": "^10.1.2",
    "lucide-react": "^1.23.0",
    "node-forge": "^1.3.3",
    "posthog-docusaurus": "^2.0.5",
    "posthog-js": "^1.360.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.71.2",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "tinyglobby": "^0.2.15",
    "unified": "^11.0.5",
    "use-stick-to-bottom": "^1.1.3",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "@mastra/lint-docs": "^1.1.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.19.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "baseline-browser-mapping": "^2.10.8",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "0.59.0",
    "postcss": "^8.5.8",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
